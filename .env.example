# Copie para .env (que NÃO vai pro Git) e preencha.

# Intervals.icu → Settings → Developer Settings → API Key (a SUA, de treinador)
INTERVALS_API_KEY=

# Atletas autorizados: apelido=athlete_id, separados por vírgula.
# O athlete_id começa com "i" (está na URL do perfil no Intervals, ex.: i123456).
# Inclua você mesmo se quiser publicar no seu calendário.
INTERVALS_ATHLETES=eu=i000000,atleta1=i000000

# 1 = simula as escritas (criar/atualizar/apagar) sem chamar a API. Útil no primeiro teste.
INTERVALS_DRY_RUN=0
